[Unit]
Description=OpenVibe.Space — code and dynamic pages for the OpenVibe network
# Network (identity) should be up first, but Space degrades gracefully if it is not: the home page and
# the discovery files still work, sign-in is unavailable (server/observability.js).
After=network.target postgresql.service pgbouncer.service
Wants=openvibe-network.service postgresql.service pgbouncer.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/openvibe.space
EnvironmentFile=/etc/openvibe/space.env
Environment=NODE_ENV=production
Environment=PORT=4940
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /opt/openvibe.space/server/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The code tree stays read-only. Space's database is PostgreSQL (ov_space, ADR-035).
StateDirectory=openvibe-space

[Install]
WantedBy=multi-user.target
