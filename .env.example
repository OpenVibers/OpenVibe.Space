# ═══════════════════════════════════════════════════════════════
# openvibe.space — Environment Configuration
# Copy to .env and fill in values.
# In production this lives at /etc/openvibe/space.env (0600).
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4940
HOST=127.0.0.1
NODE_ENV=development
BASE_URL=http://localhost:4940
# Proxy hops that set X-Forwarded-For (Cloudflare → nginx → Node = 2)
TRUST_PROXY=2

# Identity provider — OpenVibe.Network (OAuth2 authorization server + JWKS)
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000

# OAuth2 client credentials (client `space` registered in the Network DB,
# redirect https://openvibe.space/auth/callback)
OV_OAUTH_CLIENT_ID=space
OV_OAUTH_CLIENT_SECRET=change-me-to-the-registered-space-secret
# Production: https://openvibe.space/auth/callback
OV_OAUTH_REDIRECT_URI=http://localhost:4940/auth/callback

# Cookies — production default is Secure; set false for plain-http local dev
#COOKIE_SECURE=false

# OpenVibe.Media — images on posts are med_ objects uploaded through Media's Object API
# (the OAuth client needs media.object.upload for audience openvibe.media).
OV_MEDIA_URL=https://openvibe.media
OV_MEDIA_INTERNAL_URL=http://127.0.0.1:4100

# OpenVibe.VIP: members-only spaces and threads. Space asks POST /api/v1/policies/evaluate with a
# service token (the OAuth client needs vip.resource.policy.evaluate for audience openvibe.vip).
# Without it, or with VIP down, only the owner and moderators get in (fails closed).
OV_VIP_URL=https://openvibe.vip
OV_VIP_INTERNAL_URL=http://127.0.0.1:4620
# How long a VIP yes / no / failure is cached (ms); the yes TTL bounds how long access outlives a membership.
#VIP_CACHE_TTL_MS=30000
#VIP_CACHE_DENY_TTL_MS=10000
#VIP_CACHE_UNAVAILABLE_TTL_MS=2000

# OpenVibe.Chat: a space's chat room. Space asks Chat with the signed-in person's own token whether they
# manage the room (no service grant needed); the space page links OV_CHAT_URL/r/<room>.
OV_CHAT_URL=https://openvibe.chat
OV_CHAT_INTERNAL_URL=http://127.0.0.1:4400

# OpenVibe.Community — the hub: Space's pages link the network Pulse feed it serves (D12).
OV_COMMUNITY_URL=https://openvibe.community

# IndexNow (openvibe-shared/indexnow): the key file is served at /<key>.txt and a public thread
# appearing, changing or going away pings the engines. Unset: off.
INDEXNOW_KEY=

# PostgreSQL (ADR-035), written by OpenVibe.Host roles/data/add-service.sh space: the runtime role through
# PgBouncer, the owner on a direct connection (migrations), and Valkey (shared limit counters). The forum
# lives there: spaces, threads, posts, votes, attachments, the relay's bookkeeping. Without DATABASE_URL,
# development uses an embedded PGlite database in data/pglite.
DATABASE_URL=
DATABASE_DIRECT_URL=
VALKEY_URL=
VALKEY_PREFIX=ov:space:

# Per-actor limits (server/actor-limits.js): reads one caller (a person, a service or app acting as
# itself, else an address) may make to one API per minute and per hour; past them 429 rate_limited
# with Retry-After. Writes have their own numbers (README). The per-address /api/ limit stays.
#SPACE_LIMITS_MINUTE=120
#SPACE_LIMITS_HOUR=3000

# Browser origins allowed to call the embeddable forum APIs with a Bearer Network JWT
#API_CORS_ORIGINS=https://openvibe.community,https://openvibe.live,https://openvibe.network,https://openvibe.tools

# ── Discord relay (server/relay; docs/discord-relay.md) ──────
# Outbound: new threads and replies in mapped public spaces → the mapping's Discord webhook.
# Mappings (POST /api/v1/relay/mappings, staff) name an ENVIRONMENT VARIABLE that holds the webhook
# URL — the URL itself never goes into the database.
#DISCORD_RELAY_ENABLED=true
#DISCORD_WEBHOOK_FEEDBACK=https://discord.com/api/webhooks/<id>/<token>
# Variables a mapping may name: DISCORD_WEBHOOK_* unless this lists the exact names.
#DISCORD_RELAY_WEBHOOK_VARS=DISCORD_WEBHOOK_FEEDBACK,DISCORD_WEBHOOK_GENERAL
#DISCORD_RELAY_POLL_MS=30000
#DISCORD_RELAY_BACKOFF_MS=30000
#DISCORD_RELAY_MAX_ATTEMPTS=6
# Inbound: replies on Discord become posts (a bot in the server with the MESSAGE CONTENT intent).
#DISCORD_RELAY_INBOUND=on
#DISCORD_BOT_TOKEN=
#DISCORD_GATEWAY_URL=wss://gateway.discord.gg/?v=10&encoding=json

# OpenVibe.Events — the relay's worker polls creates from the outbox through Events, and Events
# delivers Network's block/account/merge events to /internal/events (server/events-consumer.js).
EVENTS_URL=
# Signature secret Events signs deliveries with (SPACE_EVENTS_SECRET; comma-separated for rotation,
# each 32+ characters). Unset: the internal route answers 503 and nothing is applied.
SPACE_EVENTS_SECRET=
# Set 0 to stop the relay's worker from reading creates off Events (the forum queues them itself).
#DISCORD_RELAY_EVENTS=off
